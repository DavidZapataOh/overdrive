#!/usr/bin/env bash
# Dispatcher: overdrive <command> [args] runs libexec/overdrive-<command>.

# Resolve symlinks by hand: readlink -f is not available on every supported platform.
src=${BASH_SOURCE[0]}
while [ -L "$src" ]; do
  dir=$(cd -P "$(dirname "$src")" && pwd)
  src=$(readlink "$src")
  case $src in /*) ;; *) src=$dir/$src ;; esac
done
bin_dir=$(cd -P "$(dirname "$src")" && pwd)
OVERDRIVE_HOME=${bin_dir%/*}
export OVERDRIVE_HOME

usage() {
  cat <<'USAGE'
Usage: overdrive <command> [args]

Commands are the executables under libexec/ named overdrive-<command>.

  help       show this message
  version    print the plugin version
USAGE
}

case ${1-} in
  '')
    usage >&2
    exit 64
    ;;
  help | -h | --help)
    usage
    exit 0
    ;;
  version | --version)
    version=$(sed -n -e '/^[[:space:]]*"version"[[:space:]]*:/{' \
      -e 's/^[^:]*:[[:space:]]*"\([^"]*\)".*/\1/p' -e 'q' -e '}' \
      "$OVERDRIVE_HOME/.claude-plugin/plugin.json" 2>/dev/null)
    if [ -z "$version" ]; then
      printf 'overdrive: cannot read the version from plugin.json\n' >&2
      exit 1
    fi
    printf '%s\n' "$version"
    exit 0
    ;;
esac

command_name=$1
shift
case $command_name in
  *[!a-z0-9-]* | -*)
    printf 'overdrive: unknown command: %s\n' "$command_name" >&2
    usage >&2
    exit 64
    ;;
esac

target=$OVERDRIVE_HOME/libexec/overdrive-$command_name
if [ ! -f "$target" ]; then
  printf 'overdrive: unknown command: %s\n' "$command_name" >&2
  usage >&2
  exit 64
fi

# Run through the current bash so a lost exec bit (archives, Windows) does not matter.
exec "$BASH" "$target" "$@"
