#!/usr/bin/env bash
# PreToolUse guard: pinned tests stay untouched until green, the default branch is
# never pushed to, a critical run's final review and pull request wait for every task's
# review (recorded here, when the critical reviewer is dispatched), and every session
# marks the repositories it changed.
# It runs before every edit and shell command, so the common call (no pins, no push,
# no file-writing command) uses builtins only. Pins cost one cksum to check the seal;
# a shell command that pushes or may write a pinned file costs one awk to tokenize.
# It always exits 0 and never sets onFailure: a broken guard lets the call through,
# and the green evidence check catches what slipped past.

set -f
export LC_ALL=C

plugin=${CLAUDE_PLUGIN_ROOT:-}
if [ -z "$plugin" ]; then
  case ${BASH_SOURCE[0]} in
    */*) cd -P -- "${BASH_SOURCE[0]%/*}/.." 2>/dev/null && plugin=$PWD ;;
    *) cd -P .. 2>/dev/null && plugin=$PWD ;;
  esac
fi
# shellcheck source=../lib/json.sh
. "$plugin/lib/json.sh" 2>/dev/null || exit 0
# shellcheck source=../lib/path.sh
. "$plugin/lib/path.sh" 2>/dev/null || exit 0

PINS_FILE=.overdrive/run/pins
proot=''

# The plugin's own files (a skill's references) are not a project's change, even when the
# plugin sits inside the repository (vendored, or a checkout under development).
_od_posix_path "$plugin"
_od_normalize_path "$_OD_PATH"
own=${_OD_PATH%/}

# in_plugin PATH: true when PATH is the plugin directory or inside it.
in_plugin() {
  local path=$1
  case $path/ in */./* | */../* | *//*) _od_normalize_path "$path"; path=$_OD_PATH ;; esac
  case $path/ in "$own"/*) return 0 ;; esac
  return 1
}
US=$'\037'

# guard: load the checks the fast path does not need.
guard() {
  # shellcheck source=../lib/guard.sh
  [ -n "${_OD_GUARD_LOADED:-}" ] || . "$plugin/lib/guard.sh"
}

# mark ROOT [EDIT]: record that this session changed files in ROOT. Only the session's
# first call in ROOT forks: it records the commit the change starts from and a checksum
# of the refs, so the Stop hook also classifies what gets committed meanwhile and sees
# a change that left HEAD and the worktree as they were, and lists ROOT in the session's
# roots so the Stop hook finds it from any cwd. EDIT notes that a file tool wrote in
# ROOT, which may be an ignored file no status shows.
mark() {
  local run=$1/.overdrive/run s head data=${CLAUDE_PLUGIN_DATA:-}
  [ -n "$sid" ] || return 0
  s=${sid//[!A-Za-z0-9._-]/_}
  if [ -n "${2-}" ] && [ -d "$run/markers" ] && [ ! -f "$run/markers/$s.edited" ]; then
    { : > "$run/markers/$s.edited"; } 2>/dev/null
  fi
  [ ! -f "$run/markers/$s.changed" ] || return 0
  if [ ! -d "$run/markers" ]; then
    mkdir -p "$run/markers" 2>/dev/null || return 0
  fi
  [ -f "$run/.gitignore" ] || { printf '*\n' > "$run/.gitignore"; } 2>/dev/null
  head=$(git -C "$1" rev-parse -q --verify 'HEAD^{commit}' 2>/dev/null) || head=unborn
  _od_refs_sum "$1" || _OD_REFS=unknown
  [ -z "${2-}" ] || { : > "$run/markers/$s.edited"; } 2>/dev/null
  { printf '%s\nrefs %s\n' "$head" "$_OD_REFS" > "$run/markers/$s.changed"; } 2>/dev/null || return 0
  if [ -n "$data" ]; then
    [ -d "$data/sessions" ] || mkdir -p "$data/sessions" 2>/dev/null
    { printf '%s\n' "$1" >> "$data/sessions/$s.roots"; } 2>/dev/null
  fi
  return 0
}

# absolute DIR WORD: set ABS to WORD resolved against DIR, normalized.
# shellcheck disable=SC2088
absolute() {
  _od_posix_path "$2"
  case $_OD_PATH in
    /* | [A-Za-z]:*) ;;
    '~') _OD_PATH=$HOME ;;
    '~/'*) _OD_PATH=$HOME/${_OD_PATH#'~/'} ;;
    *) _OD_PATH=$1/$_OD_PATH ;;
  esac
  _od_posix_path "$_OD_PATH"
  _od_normalize_path "$_OD_PATH"
  ABS=$_OD_PATH
}

file_tool() {
  local path
  json_extract_string file_path "$input" || json_extract_string notebook_path "$input" || return 0
  path=$JSON_VALUE
  _od_posix_path "$path"
  case $_OD_PATH in
    /* | [A-Za-z]:*) ;;
    *) [ -n "$cwd" ] || return 0; absolute "$cwd" "$path"; _OD_PATH=$ABS ;;
  esac
  ! in_plugin "$_OD_PATH" || return 0
  _od_find_root "$_OD_PATH" || return 0
  croot=$_OD_ROOT
  case $_OD_PATH in
    "$croot"/.overdrive/run/active-ledger | "$croot"/.overdrive/run/*/ledger.md)
      guard
      deny "The ledger is written only by $plugin/bin/overdrive ledger add: the guard writes the review and change records itself, and a file tool would forge them."
      ;;
  esac
  if [ -f "$croot/$PINS_FILE" ]; then
    guard
    check_target "$_OD_PATH" '' ''
  fi
  # Runtime state (a risk-map proposal, briefs, findings) ignores itself and is no change.
  case $_OD_PATH in "$croot"/.overdrive/run/*) return 0 ;; esac
  mark "$croot" edit
}

# read_only: true when the command plainly changes no file (a conservative allowlist).
read_only() {
  local seg segs part parts first=1 n IFS
  # shellcheck disable=SC2016
  case $cmd in *'$('* | *'`'* | *'<('* | *'>('*) return 1 ;; esac
  case $cmd in
    *'>'*)
      IFS='>' read -r -d '' -a parts <<<"$cmd"
      for part in "${parts[@]}"; do
        if [ -n "$first" ]; then first=''; continue; fi
        case $part in '' | '&'* | /dev/null* | ' /dev/null'*) ;; *) return 1 ;; esac
      done
      ;;
  esac
  IFS=$'\n;&|(){}' read -r -d '' -a segs <<<"$cmd"
  IFS=$' \t'
  for seg in "${segs[@]}"; do
    # shellcheck disable=SC2086
    set -- $seg
    while [ "$#" -gt 0 ]; do
      # Digits and redirections start a segment only where >& or &> was split above.
      case $1 in
        [A-Za-z_]*=* | '!' | time | then | do | else | if | while | until | [0-9]* | '>'* | '<'*) shift ;;
        *) break ;;
      esac
    done
    [ "$#" -gt 0 ] || continue
    case ${1##*/} in
      ls | cat | head | tail | grep | egrep | fgrep | rg | wc | pwd | echo | printf | which | type | \
        stat | file | du | df | tree | less | diff | cmp | date | uname | whoami | id | printenv | \
        cut | tr | jq | test | '[' | '[[' | ']]' | true | false | sleep | cd | \
        basename | dirname | realpath | readlink | hostname | ps | exit | overdrive | 'fi' | 'done' | 'esac') ;;
      sed)
        for part in "$@"; do
          case $part in -i* | --in-place* | -[!-]*i*) return 1 ;; esac
        done
        ;;
      sort | awk | gawk | uniq)
        # sort -o FILE, gawk -i inplace and uniq IN OUT write files.
        n=0
        for part in "${@:2}"; do
          case ${1##*/}:$part in
            sort:--output* | sort:-o* | sort:-[!-]*o* | awk:-i* | awk:--include* | gawk:-i* | gawk:--include*) return 1 ;;
            uniq:-[fsw]) n=$((n - 1)) ;;
            uniq:-*) ;;
            uniq:*) n=$((n + 1)) ;;
          esac
        done
        [ "$n" -lt 2 ] || return 1
        ;;
      command)
        # command rm x runs rm; only the lookups are read-only.
        case ${2-} in -v | -V) ;; *) return 1 ;; esac
        ;;
      find)
        case $seg in *-delete* | *-exec* | *-ok* | *-fprint* | *-fls*) return 1 ;; esac
        ;;
      git)
        shift
        while [ "$#" -gt 0 ]; do
          case $1 in -C | -c) shift 2 ;; -*) shift ;; *) break ;; esac
        done
        case ${1-} in
          status | diff | log | show | rev-parse | ls-files | ls-tree | blame | describe | shortlog | \
            grep | cat-file | reflog | show-ref | merge-base | rev-list | fetch | remote | branch | config | tag) ;;
          *) return 1 ;;
        esac
        ;;
      *) return 1 ;;
    esac
  done
  return 0
}

# plain_words TEXT: true when TEXT is only words and quoted strings: nothing the shell
# would chain, redirect, substitute, expand or glob.
plain_words() {
  local s=$1 i c q=''
  for ((i = 0; i < ${#s}; i++)); do
    c=${s:i:1}
    case $q in
      "'") [ "$c" != "'" ] || q=''; continue ;;
      '"')
        case $c in
          '"') q='' ;;
          '$' | '`' | \\) return 1 ;;
        esac
        continue
        ;;
    esac
    case $c in
      "'" | '"') q=$c ;;
      [\;\&\|\<\>\$\`\(\)\{\}\\\*\?\[\~\#] | $'\n' | $'\r') return 1 ;;
    esac
  done
  [ -z "$q" ]
}

# allow REASON: approve the call without a permission prompt. Deny and ask rules in the
# user's settings still apply.
allow() {
  printf '{"hookSpecificOutput":{"hookEventName":"PreToolUse","permissionDecision":"allow","permissionDecisionReason":"%s"}}\n' "$1"
}

# quoting_of TEXT: set bare, sq and dq to 1 for each way TEXT can stand in a command as
# one literal word: unquoted (a plain path only, since an expansion splits and globs),
# in single quotes (no single quote inside) and in double quotes (nothing the shell
# expands inside).
quoting_of() {
  bare='' sq='' dq=''
  case $1 in *[!A-Za-z0-9_./:@%+,=-]*) ;; *) bare=1 ;; esac
  case $1 in *"'"*) ;; *) sq=1 ;; esac
  case $1 in *'"'* | *'$'* | *'`'* | *\\*) ;; *) dq=1 ;; esac
}

# own_cli_form: set CLI_CMD to cmd with the router's root variable expanded, when cmd is
# one assignment of a variable to this plugin's root followed by one call through that
# variable: R=ROOT; "$R"/bin/overdrive ... The assigned value must be the root exactly.
own_cli_form() {
  local name=${cmd%%=*} rest=${cmd#*=} v lead bare sq dq
  # Only names the router uses: variables the shell itself reads must not qualify.
  case $name in
    *[!A-Z0-9_]* | [!A-Z]*) return 1 ;;
    R | ROOT | OD_ROOT | PLUGIN_ROOT) ;;
    *) return 1 ;;
  esac
  quoting_of "$plugin"
  case $rest in
    "\"$plugin\""*) [ -n "$dq" ] || return 1; rest=${rest#"\"$plugin\""} ;;
    "'$plugin'"*) [ -n "$sq" ] || return 1; rest=${rest#"'$plugin'"} ;;
    "$plugin"*) [ -n "$bare" ] || return 1; rest=${rest#"$plugin"} ;;
    *) return 1 ;;
  esac
  rest=${rest#"${rest%%[! ]*}"}
  case $rest in
    ';'*) rest=${rest#;} ;;
    '&&'*) rest=${rest#&&} ;;
    *) return 1 ;;
  esac
  rest=${rest#"${rest%%[! ]*}"}
  for v in "\"\$$name/bin/overdrive\"" "\"\${$name}/bin/overdrive\"" "\"\$$name\"/bin/overdrive" "\"\${$name}\"/bin/overdrive"; do
    case $rest in "$v "* | "$v") lead=$v; break ;; esac
  done
  if [ -z "${lead-}" ] && [ -n "$bare" ]; then
    for v in "\$$name/bin/overdrive" "\${$name}/bin/overdrive"; do
      case $rest in "$v "* | "$v") lead=$v; break ;; esac
    done
  fi
  [ -n "${lead-}" ] || return 1
  CLI_CMD=$plugin/bin/overdrive${rest#"$lead"}
}

# own_read_only_cli: true when cmd runs this plugin's CLI, by its absolute path or through
# the root variable the router describes, for a command that only reads: classification,
# decision ids and checks, recall. The router runs these before every change, and a
# permission prompt for each would cost the user a step on trivial work.
own_read_only_cli() {
  local exe=$plugin/bin/overdrive rest bare sq dq
  # A quoting that is not literal for this root (a quote inside it, say) would let the
  # rest of the command be read as part of the path.
  quoting_of "$exe"
  case $cmd in
    [A-Za-z_]*=*) own_cli_form || return 1; rest=${CLI_CMD#"$exe"} ;;
    "$exe "*) [ -n "$bare" ] || return 1; rest=${cmd#"$exe"} ;;
    "\"$exe\" "*) [ -n "$dq" ] || return 1; rest=${cmd#"\"$exe\""} ;;
    "'$exe' "*) [ -n "$sq" ] || return 1; rest=${cmd#"'$exe'"} ;;
    *) return 1 ;;
  esac
  case $rest in
    ' risk' | ' risk '* | ' decisions next-id' | ' decisions next-id '* | ' decisions check' | \
      ' decisions check '* | ' recall '*) ;;
    *) return 1 ;;
  esac
  plain_words "$rest"
}

# review_gate WHAT EXTRA [FLAG...]: deny WHAT while the active ledger of the repository
# around cwd holds a critical task with no critical review after its last change. EXTRA
# is added to the deny text; FLAGs go to overdrive ledger unreviewed. Any failure to read
# the ledger lets the call through.
review_gate() {
  local root open verb=has noun=task cli what=$1 extra=$2
  shift 2
  [ -n "$cwd" ] && _od_find_root "$cwd" || return 0
  root=$_OD_ROOT
  [ -f "$root/.overdrive/run/active-ledger" ] || return 0
  open=$(cd "$root" 2>/dev/null && "${BASH:-bash}" "$plugin/bin/overdrive" ledger unreviewed "$@" 2>/dev/null </dev/null | paste -sd, - | sed 's/,/, /g') || return 0
  [ -n "$open" ] || return 0
  case $open in *,*) verb=have noun=tasks ;; esac
  cli="'$plugin/bin/overdrive'"
  guard
  deny "$what is blocked: $noun $open $verb no critical review after the last change. For each, run $cli review-package --base <task base> --head HEAD --brief <brief> --lane critical, then dispatch overdrive:critical-reviewer with \"Task <N>\" in its description (the guard records the review when it is dispatched).${extra:+ $extra}"
}

# task_numbers: set NUMS to the tasks a dispatch names: those in its description ("Task 2",
# "Tasks 1-2", "Tasks 1, 2"), else the brief path in its prompt. Free prompt text names
# no task: it mentions tasks the work merely depends on.
task_numbers() {
  local desc='' prompt='' body n prev='' sep re_list='(^|[^A-Za-z])[Tt]asks? +#?([0-9]+)(([ ]*[-,][ ]*|[ ]+and[ ]+)#?[0-9]+)*' re_num='^([0-9]+)([^0-9]*)(.*)$' re_brief='task-([1-9][0-9]*)\.md'
  NUMS=()
  json_extract_string description "$input" && desc=$JSON_VALUE
  if [[ $desc =~ $re_list ]]; then
    body=${BASH_REMATCH[0]}
    body=${body#"${body%%[0-9]*}"}
    while [[ $body =~ $re_num ]]; do
      n=$((10#${BASH_REMATCH[1]}))
      sep=${BASH_REMATCH[2]}
      body=${BASH_REMATCH[3]}
      if [ -n "$prev" ] && [[ $sep == *-* ]] && [ "$n" -gt "$prev" ] && [ $((n - prev)) -le 50 ]; then
        while [ "$prev" -lt "$n" ]; do prev=$((prev + 1)); NUMS[${#NUMS[@]}]=$prev; done
      else
        NUMS[${#NUMS[@]}]=$n
      fi
      prev=$n
    done
    return 0
  fi
  json_extract_string prompt "$input" && prompt=$JSON_VALUE
  if [[ $prompt =~ $re_brief ]]; then NUMS[0]=${BASH_REMATCH[1]}; fi
}

# record_dispatch KIND: a dispatch is the proof of a review or of a change: the guard
# records it, so the ledger holds what happened and not what the controller wrote.
record_dispatch() {
  local root n
  task_numbers
  [ "${#NUMS[@]}" -gt 0 ] || return 0
  [ -n "$cwd" ] && _od_find_root "$cwd" || return 0
  root=$_OD_ROOT
  [ -f "$root/.overdrive/run/active-ledger" ] || return 0
  for n in "${NUMS[@]}"; do
    (cd "$root" 2>/dev/null && "${BASH:-bash}" "$plugin/bin/overdrive" ledger "_record-$1" "$n" >/dev/null 2>&1 </dev/null) || :
  done
}

agent_tool() {
  json_extract_string subagent_type "$input" || return 0
  case $JSON_VALUE in
    final-reviewer | overdrive:final-reviewer)
      review_gate "Dispatching the final review" "A standard or direct task still open at the end of the slice must be marked complete, or critical and reviewed." --all-started
      ;;
    critical-reviewer | overdrive:critical-reviewer) record_dispatch review ;;
    builder | overdrive:builder) record_dispatch change ;;
  esac
}

# Word boundaries keep a commit message or a grep pattern that mentions the command from matching.
GH_PR_RE='(^|[;&|( ])gh ([^;&|]* )?pr +(create|merge)([ ;&|]|$)'

# The ledger's internal entry points for the records the guard writes.
RECORD_RE='ledger[^;&|]* _record-(review|change)([ ;&|"'"'"']|$)'

# record_call: deny cmd when it runs an internal entry point. A mention inside a quoted
# string (a search pattern, a commit message) is only text; the quote state before the
# word tells them apart.
record_call() {
  local rest=$cmd acc='' m before q c state=''
  while [[ $rest =~ $RECORD_RE ]]; do
    m=${BASH_REMATCH[0]}
    before=$acc${rest%%"$m"*}${m%_record-*}
    q=${before//[!\"\']/}
    state=''
    while [ -n "$q" ]; do
      c=${q:0:1}
      q=${q:1}
      if [ -z "$state" ]; then state=$c; elif [ "$c" = "$state" ]; then state=''; fi
    done
    if [ -z "$state" ]; then
      guard
      deny "The review and change records are written by the guard when overdrive:critical-reviewer or overdrive:builder is dispatched with \"Task N\" in its description; they are not commands to run."
    fi
    acc=$acc${rest%%"$m"*}$m
    rest=${rest#*"$m"}
  done
}

bash_tool() {
  local croot_pins='' need='' ro='' a roots=''
  json_extract_string command "$input" || return 0
  cmd=$JSON_VALUE
  case $cmd in *_record-*) record_call ;; esac
  if [[ $cmd =~ $GH_PR_RE ]]; then
    # A merge can run from the default branch, away from the run's own.
    case $cmd in
      *merge*) review_gate "Opening or merging the pull request" '' --any-branch ;;
      *) review_gate "Opening or merging the pull request" '' ;;
    esac
  fi
  if own_read_only_cli; then
    allow "Overdrive read-only command"
    return 0
  fi
  croot=''
  if [ -n "$cwd" ]; then
    absolute / "$cwd"
    cwd=$ABS
    if _od_find_root "$cwd"; then
      croot=$_OD_ROOT
      [ ! -f "$croot/$PINS_FILE" ] || croot_pins=1
    fi
  else
    cwd=$PWD
  fi
  # A read-only command writes nothing and pushes nothing: no reading needed.
  if read_only; then
    ro=1
  else
    case $cmd in *push*) need=1 ;; esac
    if [ -z "$croot" ]; then
      # Outside a repository, any target or directory could be in one.
      need=1
    elif [ -n "$croot_pins" ]; then
      case $cmd in
        *'>'* | *rm* | *mv* | *cp* | *tee* | *sed* | *perl* | *truncate* | *dd* | *ln* | *install* | \
          *checkout* | *switch* | *restore* | *unlink* | *shred* | *sort* | *awk* | *uniq* | \
          *cd* | *-C* | *-c* | *eval*) need=1 ;;
      esac
    else
      # Without pins nearby, only a change of directory reaches pins or another
      # repository to mark.
      case $cmd in *cd* | *-C* | *-c* | *eval*) need=1 ;; esac
    fi
  fi
  [ -n "$ro" ] || [ -z "$croot" ] || in_plugin "$cwd" || roots=$croot$'\n'
  if [ -n "$need" ]; then
    guard
    scan
  fi
  # Marked only once every check has passed: a denied command changes nothing.
  while IFS= read -r a; do
    [ -z "$a" ] || mark "$a"
  done <<<"$roots"
}

# scan: check the records shell-words.awk prints for cmd, and add the repository of
# every directory a mutating command runs in to roots.
scan() {
  local records rec f a dir
  records=$(OD_CWD=$cwd awk -f "$plugin/lib/shell-words.awk" <<<"$cmd" 2>/dev/null) || records=''
  while IFS= read -r rec; do
    [ -n "$rec" ] || continue
    IFS=$US read -r -a f <<<"$rec"
    dir=${f[1]-}
    case ${f[0]} in
      D)
        # Every repository the command runs in, once each.
        if [ -n "$ro" ] || in_plugin "$dir" || ! _od_find_root "$dir"; then continue; fi
        case $'\n'$roots in *$'\n'"$_OD_ROOT"$'\n'*) ;; *) roots=$roots$_OD_ROOT$'\n' ;; esac
        ;;
      P) check_push "$dir" "${f[@]:2}" ;;
      S) check_switch "$dir" "${f[@]:2}" ;;
      W)
        absolute "$dir" "${f[2]-}"
        check_target "$ABS" 1 1
        ;;
      C)
        absolute "$dir" "${f[2]-}"
        a=$ABS
        check_target "$a" '' 1
        if [ -n "${f[3]-}" ]; then
          check_target "$a/${f[3]##*/}" '' 1
        fi
        ;;
    esac
  done <<<"$records"
}

# own_file PATH: true when PATH, spelled as the tool will open it, is the plugin directory
# or a file or directory inside it, and no symbolic link leads out. The lexical test comes
# first so an unrelated path costs no change of directory.
own_file() {
  local p=$1 dir phys
  _od_posix_path "$p"
  p=$_OD_PATH
  case $p in
    /* | [A-Za-z]:*) ;;
    *) [ -n "$cwd" ] || return 1; p=$cwd/$p ;;
  esac
  # A dot segment resolves differently opened as written than normalized, through a link.
  case $p/ in */./* | */../*) return 1 ;; esac
  _od_normalize_path "$p"
  p=$_OD_PATH
  in_plugin "$p" || return 1
  [ -n "$proot" ] || { cd -P -- "$plugin" 2>/dev/null && proot=$PWD; } || return 1
  [ -e "$p" ] || return 1
  if [ -d "$p" ]; then
    dir=$p
  else
    [ ! -L "$p" ] || return 1
    dir=${p%/*}
  fi
  cd -P -- "${dir:-/}" 2>/dev/null || return 1
  phys=$PWD
  case $phys/ in "$proot"/*) return 0 ;; esac
  return 1
}

# read_tool: a Read inside the plugin only reads its own references.
read_tool() {
  json_extract_string file_path "$input" || return 0
  own_file "$JSON_VALUE" || return 0
  allow "Overdrive plugin file"
}

input=''
IFS= read -r -d '' input || :
json_extract_strings "$input" tool_name session_id cwd
tool=${JSON_VALUES[0]-} sid=${JSON_VALUES[1]-} cwd='' cmd='' croot=''
if [ -n "${JSON_VALUES[2]-}" ]; then
  _od_posix_path "${JSON_VALUES[2]}"
  cwd=$_OD_PATH
fi

case $tool in
  Edit | Write | MultiEdit | NotebookEdit) file_tool ;;
  Bash) bash_tool ;;
  Agent | Task) agent_tool ;;
  Read) read_tool ;;
esac
exit 0
