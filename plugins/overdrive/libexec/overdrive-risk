#!/usr/bin/env bash
# overdrive risk: put a change in the direct, standard or critical lane from facts.
# Any failure to classify prints the critical lane and exits 3: a change is never
# placed below critical because something could not be read.

set -u -o pipefail
export LC_ALL=C
# These would change the patch git prints; the classifier pins its own diff options.
unset GIT_DIFF_OPTS GIT_EXTERNAL_DIFF

usage() {
  cat <<'USAGE'
Usage: overdrive risk [--repo DIR] [--map FILE] MODE... [--intent TEXT]

Modes (combine freely; at least one, or --intent alone):
  --diff A..B | --diff A...B   committed changes in a range (works in a bare repository)
  --staged                     the index against HEAD
  --worktree                   tracked changes against HEAD plus untracked files
  --paths P...                 paths named before any change exists; takes every argument
                               up to the next --option, or every one after a lone --.
                               Relative paths are read from the repository root and, below
                               it, from the current directory too

  --repo DIR    repository to classify (default: the one containing the current directory)
  --map FILE    risk map to use instead of the project's. By default the project map is
                .overdrive/risk-map.conf on both sides of the change, joined, so that a
                change cannot lower its own lane by editing the map
  --intent TEXT the request, before any work starts: its words are matched against the
                keyword rules

Output: lane, item, note and next lines, then "Risk: <lane> — <items | none>".
Exit: 0 classified, 3 classification failed (reported as critical), 64 usage error.
USAGE
}

usage_error() {
  printf 'overdrive risk: %s\n' "$1" >&2
  usage >&2
  exit 64
}

next_critical='Full TDD plan approved by the user; per-task critical review and final review.'

notes=''
next_first=''

# add_note TEXT: a note line for the output, kept in the order added.
add_note() {
  notes=$notes${notes:+$_OD_NL}$1
}
printf -v _OD_NL '\n'

# fail_closed REASON: the classification failed, so the change is critical. In a subshell
# it only exits, and the caller that checks the subshell prints the classification.
fail_closed() {
  local n rest=$notes
  trap - ERR
  printf 'overdrive risk: classification failed: %s\n' "$1" >&2
  [ "$BASH_SUBSHELL" -eq 0 ] || exit 3
  printf 'lane critical\nitem classification-failed critical failure %s\n' "$1"
  while [ -n "$rest" ]; do
    n=${rest%%"$_OD_NL"*}
    printf 'note %s\n' "$n"
    [ "$n" != "$rest" ] || break
    rest=${rest#*"$_OD_NL"}
  done
  printf 'next %s\nRisk: critical — classification-failed\n' "$next_critical"
  exit 3
}
# Every command of this script whose failure is not handled where it runs ends here. The
# trap is not inherited (no errtrace): bash 3.2 would fire it inside command substitutions
# whose status the caller checks, turning a reported failure into an internal one.
trap 'fail_closed "internal error at line $LINENO"' ERR

repo=''
map=''
intent=''
have_intent=''
have_mode=''
staged=''
worktree=''
ranges=()
paths=()
while [ "$#" -gt 0 ]; do
  case $1 in
    --repo | --map | --intent | --diff)
      [ "$#" -ge 2 ] || usage_error "$1 needs a value"
      case $1 in
        --repo) repo=$2 ;;
        --map) map=$2 ;;
        --intent) intent=$2 have_intent=1 ;;
        --diff)
          case $2 in
            -*) usage_error "invalid range: $2" ;;
            *..*) ranges+=("$2"); have_mode=1 ;;
            *) usage_error "--diff takes A..B or A...B, got: $2" ;;
          esac
          ;;
      esac
      shift 2
      ;;
    --staged) staged=1 have_mode=1; shift ;;
    --worktree) worktree=1 have_mode=1; shift ;;
    --paths)
      shift
      n=${#paths[@]}
      while [ "$#" -gt 0 ]; do
        case $1 in
          --)
            shift
            while [ "$#" -gt 0 ]; do paths+=("$1"); shift; done
            break
            ;;
          --*) break ;;
        esac
        paths+=("$1")
        shift
      done
      [ "${#paths[@]}" -gt "$n" ] || usage_error "--paths needs at least one path"
      have_mode=1
      ;;
    -h | --help) usage; exit 0 ;;
    *) usage_error "unknown argument: $1" ;;
  esac
done
[ -n "$have_mode" ] || [ -n "$have_intent" ] || usage_error "give a mode or --intent"

lib=${OVERDRIVE_HOME:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}/lib
# shellcheck source=../lib/common.sh
. "$lib/common.sh" || fail_closed "cannot load the library"
# shellcheck source=../lib/glob.sh
. "$lib/glob.sh" || fail_closed "cannot load the library"
# shellcheck source=../lib/riskmap.sh
. "$lib/riskmap.sh" || fail_closed "cannot load the library"
# shellcheck source=../lib/text.sh
. "$lib/text.sh" || fail_closed "cannot load the library"
# shellcheck source=../lib/signals.sh
. "$lib/signals.sh" || fail_closed "cannot load the library"

# A sandboxed shell can hand out a TMPDIR nobody may write to. /tmp comes next, then
# the repository's self-ignoring run directory, writable wherever the change can be made.
if ! work=$(mktemp -d "${TMPDIR:-/tmp}/overdrive-risk.XXXXXX" 2>/dev/null) &&
  ! work=$(mktemp -d /tmp/overdrive-risk.XXXXXX 2>/dev/null); then
  top=$(od_repo_root "${repo:-$PWD}") ||
    fail_closed "cannot create a work directory: TMPDIR and /tmp refused it and no repository was found"
  run=$(od_run_dir "$top" 2>&1) || fail_closed "cannot create a work directory: ${run%%"$_OD_NL"*}"
  # mktemp prints only the path on success, so its output is the path or the reason.
  work=$(mktemp -d "$run/risk.XXXXXX" 2>&1) || fail_closed "cannot create a work directory: ${work%%"$_OD_NL"*}"
fi
trap 'rm -rf "$work"' EXIT

# git_error: the first line git wrote on stderr, for the failure reason.
git_error() {
  local line=''
  if [ -s "$work/git.err" ]; then IFS= read -r line < "$work/git.err" || :; fi
  printf '%s' "${line:-git failed}"
}

# The repository is found from --repo or the current directory, never from the session's
# project directory: sessions often start in a folder above the repository.
top=''
if [ -n "$repo" ]; then
  # Two lines in a working tree ("true", then the way up to its top level), one when bare.
  where=$(git -C "$repo" rev-parse --is-inside-work-tree --show-cdup 2>/dev/null) ||
    fail_closed "not a git repository"
  if [ "${where%%"$_OD_NL"*}" = true ]; then
    cdup=${where#true}
    cdup=${cdup#"$_OD_NL"}
    # The top level is spelled from DIR, not resolved, so that absolute --paths written
    # the way the caller sees the repository (through symlinks, too) fall inside it.
    _od_posix_path "$repo"
    case $_OD_PATH in /*) top=$_OD_PATH/$cdup ;; *) top=$PWD/$_OD_PATH/$cdup ;; esac
    _od_normalize_path "$top"
    top=$_OD_PATH
    gitdir=$top
  else
    gitdir=$repo
  fi
else
  top=$(od_repo_root "$PWD") || fail_closed "not a git repository"
  gitdir=$top
fi
if [ -z "$top" ] && { [ -n "$staged" ] || [ -n "$worktree" ]; }; then
  fail_closed "no working tree for --staged or --worktree"
fi

# What the classification reads: HEAD, then both sides of every range (the merge
# base for A...B), resolved in one call; the first one missing names the failure.
revs=('HEAD')
for range in ${ranges[@]+"${ranges[@]}"}; do
  case $range in
    *...*) base=${range%%...*} end=${range#*...} ;;
    *) base=${range%%..*} end=${range#*..} ;;
  esac
  if [ "${range#*...}" != "$range" ]; then
    base=$(git -C "$gitdir" merge-base "${base:-HEAD}" "${end:-HEAD}" 2>"$work/git.err") ||
      fail_closed "cannot find the merge base of $range: $(git_error)"
  fi
  revs+=("${base:-HEAD}" "${end:-HEAD}")
done
# A range side may be a tree (the empty tree before a root commit), so sides peel to trees.
sides=('HEAD^{commit}')
for rev in "${revs[@]:1}"; do sides+=("$rev^{tree}"); done
if ! resolved=$(git -C "$gitdir" rev-parse "${sides[@]}" 2>"$work/git.err"); then
  # Without a first commit there is nothing to compare against, in any mode.
  git -C "$gitdir" rev-parse -q --verify 'HEAD^{commit}' >/dev/null 2>&1 || fail_closed "no commits yet"
  for rev in "${revs[@]}"; do
    git -C "$gitdir" rev-parse -q --verify "$rev^{tree}" >/dev/null 2>&1 || fail_closed "cannot read $rev"
  done
  fail_closed "cannot read the commits: $(git_error)"
fi

# The project map on every side of the change: the working tree, the index and the
# commits each mode compares, looked up in one call and read once per distinct blob.
maps=()
if [ -n "$map" ]; then
  maps=("$map")
else
  wanted=''
  [ -z "$top" ] || [ ! -e "$top/.overdrive/risk-map.conf" ] || maps=("$top/.overdrive/risk-map.conf")
  if [ "${#ranges[@]}" -gt 0 ]; then
    # Every resolved side but HEAD, which is added below.
    wanted=${resolved#*"$_OD_NL"}
    wanted=${wanted//$_OD_NL/:.overdrive/risk-map.conf$_OD_NL}:.overdrive/risk-map.conf$_OD_NL
  fi
  # The committed and staged maps always count, so an uncommitted edit of the map cannot
  # lower a classification, before work or after. A conflicted map has stages 2 and 3.
  wanted=$wanted${resolved%%"$_OD_NL"*}:.overdrive/risk-map.conf$_OD_NL
  [ -z "$top" ] || wanted=$wanted:0:.overdrive/risk-map.conf$_OD_NL:2:.overdrive/risk-map.conf$_OD_NL:3:.overdrive/risk-map.conf$_OD_NL
  printf '%s' "$wanted" > "$work/wanted"
  git -C "$gitdir" cat-file --batch-check='%(objectname) %(objecttype)' < "$work/wanted" > "$work/found" 2>"$work/git.err" ||
    fail_closed "cannot look up the risk map: $(git_error)"
  current=''
  [ "${#maps[@]}" -eq 0 ] || IFS= read -r -d '' current < "${maps[0]}" || :
  seen=' '
  while read -r blob kind; do
    [ "$kind" = blob ] || continue
    case $seen in *" $blob "*) continue ;; esac
    seen="$seen$blob "
    git -C "$gitdir" cat-file blob "$blob" > "$work/map.$blob" 2>"$work/git.err" ||
      fail_closed "cannot read the risk map $blob: $(git_error)"
    # The committed map usually equals the working tree's; one copy of its rules is enough.
    if [ -n "$current" ]; then
      IFS= read -r -d '' content < "$work/map.$blob" || :
      [ "$content" != "$current" ] || continue
    fi
    maps+=("$work/map.$blob")
  done < "$work/found"
  # The note says who acts on it: a direct change loads no skill on its own account.
  if [ "${#maps[@]}" -eq 0 ]; then
    if [ -n "$top" ] && [ -f "$top/.overdrive/run/risk-map.proposed" ]; then
      add_note 'risk-map missing; a proposal waits for approval in .overdrive/run/risk-map.proposed'
    else
      add_note 'risk-map missing; propose one with overdrive:risk-triage'
      next_first='Load overdrive:risk-triage and propose the risk map, then: '
    fi
  fi
fi

rc=0
signals_rules "$lib/floors.conf" ${maps[@]+"${maps[@]}"} > "$work/rules" || rc=$?
case $rc in
  0) ;;
  65) fail_closed "invalid risk map" ;;
  *) fail_closed "cannot read risk map" ;;
esac

: > "$work/records"
for range in ${ranges[@]+"${ranges[@]}"}; do
  signals_changes "$gitdir" "$work" diff "$range" >> "$work/records" ||
    fail_closed "cannot read the changes in $range: $(git_error)"
done
if [ -n "$staged" ]; then
  signals_changes "$gitdir" "$work" staged >> "$work/records" ||
    fail_closed "cannot read the staged changes: $(git_error)"
fi
if [ -n "$worktree" ]; then
  signals_changes "$gitdir" "$work" worktree >> "$work/records" ||
    fail_closed "cannot read the working tree changes: $(git_error)"
fi
if [ "${#paths[@]}" -gt 0 ]; then
  named=()
  physical=''
  # A relative path written from a directory below the root is judged both as relative to
  # that directory and as relative to the root: the extra spelling can only add items.
  below=''
  if [ -n "$top" ]; then
    _od_posix_path "$PWD"
    _od_normalize_path "$_OD_PATH"
    cwd=$_OD_PATH
    if [ "${cwd#"$top"/}" != "$cwd" ]; then
      below=${cwd#"$top"/}
    else
      physical=$(cd "$top" && pwd -P) || physical=$top
      cwd=$(pwd -P)
      [ "${cwd#"$physical"/}" = "$cwd" ] || below=${cwd#"$physical"/}
    fi
  fi
  for p in "${paths[@]}"; do
    _od_posix_path "$p"
    _od_normalize_path "$_OD_PATH"
    p=$_OD_PATH
    case $p in
      /*)
        if [ -n "$top" ] && [ "${p#"$top"/}" != "$p" ]; then
          p=${p#"$top"/}
        elif [ -n "$top" ]; then
          [ -n "$physical" ] || physical=$(cd "$top" && pwd -P) || physical=$top
          [ "${p#"$physical"/}" = "$p" ] || p=${p#"$physical"/}
        fi
        ;;
      *)
        if [ -n "$below" ]; then
          _od_normalize_path "$below/$p"
          named+=("$_OD_PATH")
        fi
        ;;
    esac
    named+=("$p")
  done
  signals_changes "$gitdir" "$work" paths "${named[@]}" >> "$work/records" ||
    fail_closed "cannot record the named paths"
fi

# One patch for every mode, read in a single pass. A failing git ends the group, and
# pipefail carries the failure out.
{
  for range in ${ranges[@]+"${ranges[@]}"}; do
    signals_patch "$gitdir" "$work" diff "$range" || exit
  done
  if [ -n "$staged" ]; then signals_patch "$gitdir" "$work" staged || exit; fi
  if [ -n "$worktree" ]; then signals_patch "$gitdir" "$work" worktree || exit; fi
} 2>"$work/git.err" | signals_content "$work/rules" "$work/records" "$intent" > "$work/content" ||
  fail_closed "cannot read the changed lines: $(git_error)"

: > "$work/listing"
for range in ${ranges[@]+"${ranges[@]}"}; do
  signals_listing "$gitdir" diff "$range" >> "$work/listing" 2>"$work/git.err" ||
    fail_closed "cannot list the files of $range: $(git_error)"
done
if [ -n "$staged" ] || [ -n "$worktree" ]; then
  signals_listing "$gitdir" index >> "$work/listing" 2>"$work/git.err" ||
    fail_closed "cannot list the files of the index: $(git_error)"
fi

signals_path_items "$work/records" "$work/rules" "$work/listing" "$work/coverage" > "$work/items" ||
  fail_closed "path signals failed"
# Sources no test is named after may be reached by the tests the change carries. Failing
# to read the imports keeps the items as they are, which can only leave the lane higher.
if [ -s "$work/coverage" ]; then
  if [ -n "$worktree" ]; then cover_state=worktree
  elif [ -n "$staged" ]; then cover_state=index
  else cover_state=rev
  fi
  last=''
  for range in ${ranges[@]+"${ranges[@]}"}; do last=${range##*..}; done
  if signals_import_cover "$gitdir" "$work" "$work/items" "$work/listing" "$cover_state" "${last:-HEAD}" > "$work/items.covered" 2>/dev/null; then
    mv -f "$work/items.covered" "$work/items" || fail_closed "cannot record the import coverage"
  fi
fi

# Item lines are ordered critical first, then standard, by item, keeping evidence in the
# order the changes were read; the Risk line lists each item once in the same order.
# The same evidence reached twice (two modes, two maps) is printed once.
NOTES=$notes NEXT_CRITICAL=$next_critical NEXT_FIRST=$next_first LC_ALL=C awk -F '\t' '
  BEGIN {
    next_text["direct"] = "Work inline; test first if testable; verify with evidence."
    next_text["standard"] = "Short decision plan; TDD where testable; one review at the end of the slice."
    next_text["critical"] = ENVIRON["NEXT_CRITICAL"]
  }
  $0 in seen { next }
  {
    seen[$0] = 1
    if (!($1 in count)) { name[++items] = $1; rank[$1] = 1 }
    if ($2 == "critical") rank[$1] = 0
    line[$1, ++count[$1]] = "item " $1 " " $2 " " $3 " " $4
  }
  END {
    # Few items: insertion sort by rank, then name.
    for (i = 2; i <= items; i++)
      for (j = i; j > 1 && (rank[name[j - 1]] > rank[name[j]] ||
          (rank[name[j - 1]] == rank[name[j]] && name[j - 1] > name[j])); j--) {
        t = name[j]; name[j] = name[j - 1]; name[j - 1] = t
      }
    lane = items == 0 ? "direct" : rank[name[1]] == 0 ? "critical" : "standard"
    print "lane " lane
    risk = items == 0 ? "none" : ""
    for (i = 1; i <= items; i++) {
      for (k = 1; k <= count[name[i]]; k++) print line[name[i], k]
      risk = risk (i > 1 ? ", " : "") name[i]
    }
    k = split(ENVIRON["NOTES"], note, "\n")
    for (i = 1; i <= k; i++) print "note " note[i]
    # Above direct the skill loads anyway; a direct change needs telling.
    print "next " (lane == "direct" ? ENVIRON["NEXT_FIRST"] : "") next_text[lane]
    print "Risk: " lane " — " risk
  }
' "$work/items" "$work/content" > "$work/out" || fail_closed "cannot print the classification"
# Printed only once complete, so a failure never leaves a partial classification behind.
cat "$work/out"
