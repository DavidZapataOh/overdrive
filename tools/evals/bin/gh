#!/usr/bin/env bash
# Stand-in for the GitHub CLI in eval runs. A run must never touch a real repository, so every
# call is appended to .gh-calls.log in the workspace and answered the way gh answers.
root=$(git rev-parse --show-toplevel 2>/dev/null) || root=$PWD
printf '%s\n' "$*" >> "$root/.gh-calls.log"

url=https://github.com/acme/shop/pull/7
# The pull request's state lives inside .git so a run never sees it as a workspace file.
state=$(git rev-parse --absolute-git-dir 2>/dev/null)/gh-state
[ -n "${state%/gh-state}" ] || state=$root/.gh-state
has() {
  local arg
  for arg in "$@"; do
    [ "$arg" = "$flag" ] && return 0
  done
  return 1
}

case "${1-} ${2-}" in
  'pr create')
    prev=
    for arg in "$@"; do
      if [ "$prev" = --body-file ] && [ ! -f "$arg" ]; then
        echo "open $arg: no such file or directory" >&2
        exit 1
      fi
      prev=$arg
    done
    git branch --show-current 2>/dev/null > "$state.head"
    echo "$url"
    ;;
  'pr checks')
    printf 'test\tpass\t41s\t%s/checks\n' "$url"
    ;;
  'pr merge')
    # The fixture repositories have no required status checks, which is when GitHub refuses --auto.
    flag=--auto
    if has "$@"; then
      echo "GraphQL: Pull request is in clean status (enablePullRequestAutoMerge)" >&2
      exit 1
    fi
    # A merge lands the pull request's branch on the remote's main, as GitHub does.
    head=$(cat "$state.head" 2>/dev/null)
    if [ -n "$head" ] && git remote get-url origin > /dev/null 2>&1; then
      git push -q origin "refs/heads/$head:refs/heads/main" > /dev/null 2>&1
    fi
    sha=$(git rev-parse HEAD 2>/dev/null)
    printf '%s\n' "$sha" > "$state.merged"
    echo "✓ Merged pull request acme/shop#7"
    ;;
  'pr view')
    if [ -f "$state.merged" ]; then
      printf '{"number":7,"state":"MERGED","mergedAt":"2026-01-05T17:00:00Z","mergeCommit":{"oid":"%s"},"url":"%s"}\n' "$(cat "$state.merged")" "$url"
    else
      printf '{"number":7,"state":"OPEN","mergeable":"MERGEABLE","url":"%s"}\n' "$url"
    fi
    ;;
  'run list')
    echo '[{"databaseId":1001,"name":"CI","status":"completed","conclusion":"success"}]'
    ;;
  'run watch' | 'run view' | 'auth status')
    ;;
  *)
    echo "gh: unsupported in eval runs: $*" >&2
    exit 1
    ;;
esac
