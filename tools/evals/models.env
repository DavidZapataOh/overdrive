# Pinned model IDs for every eval run, sourced by run-suite.sh and pressure.sh.
# Dateless IDs are pinned snapshots (https://platform.claude.com/docs/en/about-claude/models/overview),
# so a model rollout cannot be mistaken for a plugin regression. Revisit on each model release.
OD_EVAL_MODEL_MAIN=claude-opus-5-5
OD_EVAL_MODEL_SONNET=claude-sonnet-5-5
# The judge scores the llm graders that gate releases. Sonnet reads nuanced process rubrics more
# reliably than the CLI default (Haiku), whose formatting bias the eval docs warn about; the cost
# is a few short calls per graded run.
OD_EVAL_JUDGE=claude-sonnet-5-5
